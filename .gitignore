.idea/
.claude/
.venv*/
**/.DS_Store
*.o
# build/ ships empty (just .gitkeep); artifacts are generated, never committed
/build/*
!/build/.gitkeep
/local_logs/
/log/
tools/loader_preview/loader_preview

# Phone-side captures: sysdiagnose tarballs and log archives are hundreds of MB
# and contain the owner's device logs. Keep them local.
/logs/

# Obsidian MCP transaction journal + per-user workspace state
.obsidian-mcp/
**/.obsidian/
__pycache__/
output/

# M.I.B. release payload is staged by hand from build/ and deploy/ (see docs/deploy/install.md)
install_MoreIncredibleBash/mod/carplay/*
!install_MoreIncredibleBash/mod/carplay/.gitkeep
/install_MoreIncredibleBash/mod/last-carplay-*.log
/uninstall_MoreIncredibleBash/mod/last-carplay-*.log

# Vehicle-specific / proprietary stock inputs
/MU*-base.jar
/*-lsd.jxe
/*.ifs
/RCC_fs0.bin
/backup.zip
/eeprom*.bin
/local_stock/
/stock_inputs/
